# Copy this file to .env and fill in your own values. Git ignores .env.

# Required. Your local PostgreSQL database with the dump loaded.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/lambda_clinic

# Only needed for npm test. A separate local database whose name ends in _test.
TEST_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cosc3380_test

# Optional. Remove the # to change a default.
# PORT=4000
# FRONTEND_URL=http://localhost:5173
# Keeps you signed in when the server restarts. Use any long random text.
# SESSION_SECRET=
# Leave unset locally. The hosted backend uses production, which needs SESSION_SECRET.
# NODE_ENV=development
