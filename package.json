{
  "name": "medical-clinic-backend",
  "version": "1.0.0",
  "description": "Backend API for the medical clinic project",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "set-staff-password": "tsx src/scripts/setStaffPassword.ts",
    "test": "node --import tsx --import ./tests/helpers/testDb.ts --test --test-reporter=spec --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:file": "node --import tsx --import ./tests/helpers/testDb.ts --test --test-reporter=spec --test-concurrency=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
